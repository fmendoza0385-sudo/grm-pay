<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/paper">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/barra"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp"
        android:max="100" android:progressTint="@color/cyan" android:visibility="gone" />

    <ScrollView
        android:id="@+id/error"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/paper" android:fillViewport="true" android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical" android:padding="28dp">

            <TextView
                android:layout_width="84dp" android:layout_height="84dp" android:layout_marginTop="48dp"
                android:background="@drawable/logo_circulo" android:gravity="center"
                android:text="!" android:textColor="@color/blue600" android:textSize="46sp" android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp"
                android:text="Sin conexión con GRM PAY" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold" />

            <TextView
                android:id="@+id/txtError"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:gravity="center" android:textColor="@color/muted" android:textSize="14sp" />

            <Button
                android:id="@+id/btnReintentar"
                android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="28dp"
                android:background="@drawable/boton_principal" android:text="Reintentar"
                android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />

            <Button
                android:id="@+id/btnServidor"
                android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp"
                android:background="@drawable/boton_borde" android:text="Configurar servidor"
                android:textAllCaps="false" android:textColor="@color/blue600" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

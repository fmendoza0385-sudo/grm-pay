<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/paper" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="Servidor" android:textColor="@color/ink" android:textSize="26sp" android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="Dirección de la página de ingreso de GRM PAY dentro de la red FTTH."
            android:textColor="@color/muted" android:textSize="14sp" />

        <EditText
            android:id="@+id/txtUrl"
            android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="22dp"
            android:background="@drawable/campo" android:hint="http://172.0.20.6/GRM_PAY/login.php"
            android:imeOptions="actionDone" android:inputType="textUri" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:singleLine="true" android:textColor="@color/ink" android:textSize="15sp" />

        <TextView
            android:id="@+id/txtMsg"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textColor="#D64545" android:textSize="13sp" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp"
            android:background="@drawable/boton_principal" android:text="Guardar y abrir"
            android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />

        <Button
            android:id="@+id/btnRestablecer"
            android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp"
            android:background="@drawable/boton_borde" android:text="Usar dirección original"
            android:textAllCaps="false" android:textColor="@color/blue600" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
